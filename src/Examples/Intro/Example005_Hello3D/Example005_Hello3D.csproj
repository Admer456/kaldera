<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Example005_Hello3D</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\ExampleBase\ExampleBase.csproj" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="slangc $(ProjectDir)Shaders/hello_3d.slang -I ./ -target spirv -o $(ProjectDir)Shaders/hello_3d.spv -reflection-json $(ProjectDir)Shaders/hello_3d.spv.json"/>
    </Target>

    <Target Name="CopyShader" AfterTargets="PostBuild" DependsOnTargets="PostBuild">
        <Exec Command="cp $(ProjectDir)Shaders/hello_3d.spv $(OutDir)hello_3d.spv"/>
        <Exec Command="cp $(ProjectDir)Shaders/hello_3d.spv.json $(OutDir)hello_3d.spv.json"/>
    </Target>

</Project>
